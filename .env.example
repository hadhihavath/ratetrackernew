# ==============================================================================
# RateTracker.in Environment Configuration
# ==============================================================================

# Server / Local Hosting
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database: Supabase / PostgreSQL
# ------------------------------------------------------------------------------
# Obtain from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-feeds

# Direct PostgreSQL connection string (optional, for migrations or Prisma/pg-node)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Affiliate Integration: Cuelinks API
# ------------------------------------------------------------------------------
# Obtain from: https://developers.cuelinks.com/
CUELINKS_PUB_CID=82192
CUELINKS_API_KEY=oQab8xOk401MwoV5ofoIevFvlP_zu-WR_EarndNqpXk
CUELINKS_V3_BASE_URL=https://developers.cuelinks.com/pub_api/v3
CUELINKS_REDIRECT_BASE_URL=https://linksredirect.com/

# ------------------------------------------------------------------------------
# Product Information: Approved Merchant APIs and Feeds
# ------------------------------------------------------------------------------
# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=ratetracker-21
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Merchant Data Feeds (Croma, Reliance Digital, Vijay Sales, boAt, Samsung)
MERCHANT_FEEDS_SYNC_INTERVAL_HOURS=6
ENABLE_LIVE_FEED_SYNC=true

